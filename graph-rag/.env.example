# graph-rag/ — FastAPI Graph-RAG service on :9000

# Service
APP_NAME=crime-graph-rag
PORT=9000
API_KEY=

# Upstream LLM (inference :8080, OpenAI-compatible)
LLM_BASE_URL=http://localhost:8080
LLM_TIMEOUT_S=120
TEMPERATURE=0.0
TOP_K=1
TOP_P=1.0
REPEAT_PENALTY=1.15

# Neo4j (local instance)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j
VECTOR_INDEX_NAME=fir_embedding_index
VECTOR_DIM=1024
VECTOR_SIMILARITY_FN=cosine

# Embeddings (bge-m3 in-process, separate from LLM)
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=cpu

# Retrieval caps
SIMILARITY_THRESHOLD=0.65
SUBGRAPH_MAX_HOPS=2
SUBGRAPH_MAX_NODES=200

# OPTIONAL OCR module (leave false unless OCR dependencies installed)
ENABLE_OCR=false
