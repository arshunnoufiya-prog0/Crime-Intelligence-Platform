# ksp-iis — root environment (spec §16)
# Copy to .env and fill in. Secrets have NO defaults; services fail hard at
# startup if they are missing (spec §0.4, §17).

# ── secrets (REQUIRED — no dev defaults) ─────────────────────────────
DJANGO_SECRET_KEY=change-me
JWT_SECRET=change-me-too
POSTGRES_PASSWORD=change-me
POSTGRES_USER=ksp
POSTGRES_DB=ksp_iis
NEO4J_PASSWORD=change-me
RAG_API_KEY=change-me-internal

# ── ports (host exposure per spec §2.4) ───────────────────────────────
DJANGO_PORT=8000
NGINX_PORT=80
# 7474 is already taken on the dev laptop by an unrelated container
# (docmind-neo4j). Override locally: NEO4J_BROWSER_PORT=7475
NEO4J_BROWSER_PORT=7474

# ── llama.cpp (spec §1, §6–§8) ────────────────────────────────────────
LLAMA_TAG=b9222
# VERIFY §3.3 on the 16 GB VRAM target: nvidia-smi --query-gpu=name,compute_cap
# 86 = Ampere (RTX 30xx / A-series). Wrong value compiles but runs slow paths.
CUDA_ARCH=86
CTX_SIZE=32768
# PLACEHOLDER until Step 9 measures real KV size and re-runs the VRAM gate.
PARALLEL=2
ENABLE_MTP=false
# Flag names MUST come from the §1.3 VERIFY (llama-server --help | grep -i
# reasoning|think). Leave empty until that output is recorded in
# artifacts/verification.md; the fallback state machine in llm/client.py
# handles the split either way.
REASONING_FORMAT=
ENABLE_RERANK=true
# §8 VERIFY pending: exact rerank flag/endpoint from llama-server --help.
RERANK_FLAGS=--reranking

# ── Neo4j (spec §16) ──────────────────────────────────────────────────
# 2G/2G on ≥16 GB RAM machines; on the 7 GB dev box set both to 1G (§2.6).
NEO4J_HEAP_MAX=2G
NEO4J_PAGECACHE=2G

# ── RAG service (spec §9) ─────────────────────────────────────────────
LIGHTRAG_WORKING_DIR=/data/lightrag
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_VECTOR_STORAGE=QdrantVectorDBStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
QDRANT_URL=http://qdrant:6333
QDRANT_WORKSPACE=ksp_iis
EMBED_DIM=1024
EMBED_MAX_TOKENS=1024
CHUNK_TOKEN_SIZE=1000
CHUNK_OVERLAP_TOKEN_SIZE=120
LLM_BASE_URL=http://llama-gen:8080
EMBED_BASE_URL=http://llama-embed:8081
RERANK_BASE_URL=http://llama-rerank:8082
CYPHER_TIMEOUT_S=5
LIGHTRAG_TIMEOUT_S=12

# ── Django (spec §17) ────────────────────────────────────────────────
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
JWT_ACCESS_MINUTES=30
JWT_REFRESH_HOURS=12
RAG_URL=http://rag:9000
GRAPH_RAG_TIMEOUT=300
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
