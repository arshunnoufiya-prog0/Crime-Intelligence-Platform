# backend/ — Django settings via python-decouple

# Core
SECRET_KEY=change-this-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=crime_intel
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# JWT (different from SECRET_KEY)
JWT_SECRET=change-this-jwt-secret-too
JWT_ALGORITHM=HS256
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Graph-RAG service
GRAPH_RAG_URL=http://localhost:9000
GRAPH_RAG_TIMEOUT=120

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173