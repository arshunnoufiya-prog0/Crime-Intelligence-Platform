# inference/ — llama.cpp + Qwen3.5-4B-Instruct Q8_0 serving OpenAI-compatible API on :8080

# Model
MODEL_PATH=./models/Qwen3.5-4B-Instruct-Q8_0.gguf
# Context window
CTX_SIZE=8192
# GPU layers (-1 = full offload if VRAM allows)
N_GPU_LAYERS=-1
# Parallel slots (Q8_0 is larger than Q4 -> fewer slots)
N_PARALLEL=4
BATCH_SIZE=512
UBATCH_SIZE=512
THREADS=8
FLASH_ATTN=true

# Zero-hallucination sampling defaults
TEMPERATURE=0.0
TOP_K=1
TOP_P=1.0
REPEAT_PENALTY=1.15
MIN_P=0.05

# Server bind
HOST=0.0.0.0
PORT=8080
# Optional bearer API key (leave empty = no auth)
API_KEY=

# llama.cpp binary path (relative to inference/ root)
LLAMA_SERVER_BIN=./bin/llama-server
